# Ejemplo de variables de IA-SNAKE. Copia a .env SOLO en local (nunca se sube a git).
# En Netlify/Vercel/Render se configuran en el panel de cada servicio.

# ---------- Frontend (se INCRUSTA en el JavaScript público: nunca secretos) ----------
# Vacía en local (proxy de Vite) y en el contenedor que sirve web + API en el mismo dominio.
# En Netlify y Vercel: el origen público del backend, sin /api.
#   Desarrollo (sin proxy, backend local directo):  VITE_API_URL=http://localhost:8000
#   Producción (Netlify/Vercel):                    VITE_API_URL=https://ia-snake-api.onrender.com
VITE_API_URL=

# ---------- Backend Python (solo en el servicio que ejecuta el backend) ----------
# desarrollo | produccion
APP_ENV=desarrollo
# Clave de escritura (obligatoria en producción, mínimo 16 caracteres).
# Genera una con:  python -c "import secrets; print(secrets.token_urlsafe(32))"
IA_SNAKE_TOKEN=
# Dominios del frontend autorizados, separados por comas, sin comodines. En producción:
# https públicos y, si quieres conectar tu frontend local al backend de Render,
# http://localhost:5173 explícito. Usa los dominios REALES que te den Netlify/Vercel.
CORS_ORIGINS=
# CORS_ORIGINS=http://localhost:5173,https://ia-snake.netlify.app,https://ia-snake.vercel.app
# Opcional: vistas previas de Vercel (patrón acotado a tu proyecto):
CORS_ORIGIN_REGEX=
# CORS_ORIGIN_REGEX=^https://ia-snake-[a-z0-9-]+\.vercel\.app$
# Carpeta persistente de los modelos. Render (render.yaml): /opt/render/project/src/datos
# (disco). Contenedor Docker: /datos. Local: vacía = ./laboratorio
IA_SNAKE_DATOS=
# Puerto (el contenedor usa 8000; muchos hosts lo inyectan solos).
PORT=8000
