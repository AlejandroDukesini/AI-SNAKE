{
  "name": "arkis-ai-lab",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "description": "ARKIS AI LAB: cinco metodologias de aprendizaje (ML, simbolico, refuerzo e hibridos) resolviendo Snake. React + Vite; los modelos corren en Python.",
  "scripts": {
    "dev": "python run.py",
    "vite": "vite",
    "server": "python -m uvicorn arkis_lab.servidor.app:app --port 8000",
    "build": "vite build",
    "start": "python run.py --prod",
    "preview": "vite preview",
    "test": "python -m pytest"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.7"
  }
}
